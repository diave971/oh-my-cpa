FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -g 10001 -S omc \
    && adduser -u 10001 -S omc -G omc
COPY oh-my-cpa-arm64 /usr/local/bin/oh-my-cpa
RUN chmod +x /usr/local/bin/oh-my-cpa \
    && mkdir -p /data && chown -R omc:omc /data && chmod 700 /data
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/oh-my-cpa"]
